---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import { site } from '../../lib/site';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => data.featured);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const pad = (n: number) => String(n).padStart(2, '0');

const linkEntries = [
  ['GitHub', data.links.github],
  ['Live demo', data.links.live],
  ['Chrome Web Store', data.links.store],
].filter((entry): entry is [string, string] => Boolean(entry[1]));
---

<Base
  theme="paper"
  title={`${data.title} — case file · ${site.name}`}
  description={data.description}
>
  <Header />
  <main id="main" class="mx-auto max-w-5xl px-5 pt-32 pb-24 sm:px-8">
    <nav aria-label="Breadcrumb" data-reveal>
      <a href="/#work" class="voice-mono link-line text-mute hover:text-ink transition-colors duration-200">
        ← Back to the index
      </a>
    </nav>

    <header class="border-line mt-10 border-b pb-10">
      <p class="voice-mono text-mute" data-reveal>
        Case file <span class="text-accent">{pad(data.index)}</span> — {data.status}
        {data.period && <span> · {data.period}</span>}
      </p>
      <h1 class="voice-display mt-5 text-[clamp(2.6rem,8vw,6.5rem)]" data-reveal>{data.title}</h1>
      <p class="voice-serif text-mute mt-4 text-[clamp(1.4rem,3vw,2rem)]" data-reveal>{data.tagline}</p>

      {
        linkEntries.length > 0 && (
          <div class="mt-8 flex flex-wrap gap-3" data-reveal>
            {linkEntries.map(([label, href]) => (
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                class="pressable bg-ink text-bg voice-mono rounded-full px-5 py-3"
              >
                {label} ↗
              </a>
            ))}
          </div>
        )
      }
    </header>

    <div class="mt-12 grid gap-14 lg:grid-cols-[1fr_18rem]">
      <article class="prose-case" data-reveal>
        <Content />
      </article>

      <aside class="order-first self-start lg:order-none lg:sticky lg:top-24" data-reveal>
        <h2 class="voice-mono text-mute mb-1">Specifications</h2>
        <dl class="voice-mono">
          {
            data.specs.map((spec) => (
              <div class="border-line border-b border-dashed py-3">
                <dt class="text-mute">{spec.label}</dt>
                <dd class="text-ink mt-1 normal-case tracking-normal">{spec.value}</dd>
              </div>
            ))
          }
        </dl>
        <h2 class="voice-mono text-mute mt-8 mb-3">Stack</h2>
        <ul class="flex flex-wrap gap-1.5">
          {
            data.stack.map((tech) => (
              <li class="border-line text-ink rounded-full border px-3 py-1 text-[12.5px]">{tech}</li>
            ))
          }
        </ul>
      </aside>
    </div>

    <footer class="border-line mt-20 border-t pt-8" data-reveal>
      <a href="/#work" class="voice-mono link-line text-mute hover:text-ink transition-colors duration-200">
        ← All case files
      </a>
    </footer>
  </main>
</Base>
