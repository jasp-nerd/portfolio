---
import Base from '../layouts/Base.astro';
import { site } from '../lib/site';
---

<Base title={`404 - not in the index · ${site.name}`} description="Page not found.">
  <main id="main" class="flex min-h-svh flex-col items-start justify-center px-5 sm:px-8">
    <p class="voice-mono text-mute">Case file <span class="text-accent">404</span> - missing</p>
    <h1 class="voice-display mt-5 text-[clamp(3rem,12vw,10rem)]">Not in<br />the index.</h1>
    <p class="voice-serif text-mute mt-5 text-2xl">whatever was here, it never shipped.</p>
    <a
      href="/"
      class="pressable bg-ink text-bg voice-mono mt-10 rounded-full px-7 py-4 tracking-[0.18em]"
    >
      Back to jaspnerd.dev
    </a>
  </main>
</Base>
