---
import SectionHead from './SectionHead.astro';

const groups: [string, string[]][] = [
  ['Languages', ['Python', 'TypeScript', 'JavaScript', 'SQL', 'R']],
  [
    'AI / ML',
    ['PyTorch', 'HuggingFace Transformers', 'Fine-tuning', 'Reinforcement learning', 'NLP', 'LLM engineering', 'Prompt design'],
  ],
  [
    'Web & cloud',
    ['React', 'Next.js', 'Astro', 'Node.js', 'Flask', 'Azure', 'Docker', 'Vercel', 'Chrome extensions'],
  ],
  [
    'Data & business',
    ['Power BI', 'Power Automate', 'Quarto', 'Dashboards', 'Data pipelines', 'Stakeholder workshops'],
  ],
];

const certs: [string, string][] = [
  ['AI Fluency: Framework & Foundations', 'Anthropic · 2025'],
  ['Azure Fundamentals (AZ-900)', 'Microsoft · 2025'],
  ['Agentic AI with Azure AI Foundry', 'Microsoft · 2025'],
  ['Google Cloud Compute Skill Badge', 'Google · 2025'],
  ['Classify Images with TensorFlow', 'Google · 2025'],
  ['AI Ethics', 'Kaggle · 2025'],
];
---

<section id="skills" class="scroll-mt-20 px-5 py-20 sm:px-8 sm:py-28">
  <SectionHead index="04" label="Toolbox" title="Skills & certs" />

  <div class="grid gap-14 lg:grid-cols-[1.35fr_1fr]">
    <div class="space-y-8">
      {
        groups.map(([label, items]) => (
          <div data-reveal>
            <h3 class="voice-mono text-mute mb-3">{label}</h3>
            <ul class="flex flex-wrap gap-2">
              {items.map((item) => (
                <li class="border-line text-ink rounded-full border px-3.5 py-1.5 text-[13px]">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="self-start">
      <h3 class="voice-mono text-mute mb-2" data-reveal>Certifications</h3>
      <ul>
        {
          certs.map(([name, meta]) => (
            <li class="border-line flex flex-wrap justify-between gap-x-6 gap-y-1 border-b border-dashed py-3.5" data-reveal data-reveal-group="certs">
              <span class="text-ink text-[14px]">{name}</span>
              <span class="voice-mono text-mute">{meta}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
