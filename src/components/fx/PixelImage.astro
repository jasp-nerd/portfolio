---
/**
 * Photo that renders as dithered pixel blocks and de-pixelates.
 *  mode="step": whole image steps down to the photo when the closest
 *               `a, button, [data-fx-trigger]` ancestor is hovered or focused (or itself).
 *  mode="lens": resolution increases around the pointer (quadtree rings).
 *  tone="duotone": coarse levels use the 4-tone palette; "color" keeps image colour.
 * No JS / no WebGL2 / reduced motion: just the <img>.
 * Palette: --fx-bg / --fx-accent / --fx-ink on an ancestor. Keyboard focus on the trigger resolves it.
 * Crop to another shape with --fx-aspect on the element or an ancestor (e.g. `[--fx-aspect:1]`).
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  mode?: "step" | "lens";
  tone?: "duotone" | "color";
  /** coarsest block size in CSS px */
  block?: number;
  widths?: number[];
  sizes?: string;
  loading?: "lazy" | "eager";
  class?: string;
}
const {
  src,
  alt,
  mode = "step",
  tone = "duotone",
  block = 14,
  widths = [480, 960, 1440],
  sizes = "(min-width: 768px) 50vw, 100vw",
  loading = "lazy",
  class: cls = "",
} = Astro.props;
---

<div
  class:list={["fx-pixel relative overflow-hidden", cls]}
  data-fx="pixel"
  data-mode={mode}
  data-tone={tone}
  data-block={block}
  style={`aspect-ratio: var(--fx-aspect, ${src.width} / ${src.height})`}
>
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    loading={loading}
    class="block h-full w-full object-cover"
  />
</div>

<script>
  import { initPixel } from "../../lib/fx/pixel";
  const run = () => document.querySelectorAll<HTMLElement>("[data-fx='pixel']").forEach((el) => initPixel(el));
  run();
  document.addEventListener("astro:page-load", run); // ClientRouter, if a version enables it
</script>
