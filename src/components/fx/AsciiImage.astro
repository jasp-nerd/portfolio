---
/**
 * Photo that renders as ASCII glyphs; the pointer (or a tap) reveals the real photo.
 * No JS / no WebGL2 / reduced motion: just the <img>.
 * Palette comes from --fx-bg / --fx-ink / --fx-accent / --fx-dim on an ancestor,
 * glyph font from --fx-mono (a loaded monospace family name).
 * Keyboard focus on the closest `a, button, [data-fx-trigger]` reveals the whole photo.
 * Crop to another shape with --fx-aspect on the element or an ancestor (e.g. `[--fx-aspect:1]`).
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  mode?: "mono" | "color";
  /** cell width in CSS px (height is derived) */
  cell?: number;
  /** reveal radius in CSS px */
  radius?: number;
  /** play the dissolve-in intro when scrolled into view */
  intro?: boolean;
  widths?: number[];
  sizes?: string;
  loading?: "lazy" | "eager";
  class?: string;
}
const {
  src,
  alt,
  mode = "mono",
  cell = 7,
  radius = 140,
  intro = true,
  widths = [480, 960, 1440],
  sizes = "(min-width: 768px) 50vw, 100vw",
  loading = "lazy",
  class: cls = "",
} = Astro.props;
---

<div
  class:list={["fx-ascii relative overflow-hidden", cls]}
  data-fx="ascii"
  data-mode={mode}
  data-cell={cell}
  data-radius={radius}
  data-intro={intro ? "" : undefined}
  style={`aspect-ratio: var(--fx-aspect, ${src.width} / ${src.height})`}
>
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    loading={loading}
    class="block h-full w-full object-cover"
  />
</div>

<script>
  import { initAscii } from "../../lib/fx/ascii";
  const run = () => document.querySelectorAll<HTMLElement>("[data-fx='ascii']").forEach((el) => initAscii(el));
  run();
  document.addEventListener("astro:page-load", run); // ClientRouter, if a version enables it
</script>
