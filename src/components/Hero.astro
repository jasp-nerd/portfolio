---
import SplitLines from './SplitLines.astro';
---

<section
  class="relative flex flex-col justify-start px-5 pt-14 pb-12 sm:min-h-svh sm:justify-end sm:px-8 sm:pt-20 sm:pb-16"
>
  <div class="hero-atmosphere pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <h1 class="voice-display text-[clamp(3.1rem,12.5vw,12rem)]">
    <SplitLines trigger="load" lines={['Jasper', 'Meijerink']} />
  </h1>

  <p
    class="voice-serif text-ink mt-6 max-w-xl text-[clamp(1.5rem,3.2vw,2.4rem)] leading-tight"
    data-reveal
    data-reveal-group="hero"
  >
    ships <span class="text-gold">AI</span> people can point to.
  </p>

  <div class="mt-10 flex flex-wrap items-end justify-between gap-8" data-reveal data-reveal-group="hero">
    <p class="text-mute max-w-md text-[15px] leading-relaxed">
      Second-year BSc AI (Honours) at VU Amsterdam, AI &amp; data science
      at <strong class="text-ink font-medium">Siemens</strong>. Computer vision, LLM
      pipelines and full-stack tools in real hands, from a teacher-facing extension
      used across VU to a Canvas backup tool with 4,000+ users.
    </p>

    <dl class="voice-mono text-mute grid w-full grid-cols-1 gap-x-10 gap-y-2 sm:w-auto sm:grid-cols-2">
      <div class="flex justify-between gap-6"><dt>Tool users</dt><dd class="text-ink">4,000+</dd></div>
      <div class="flex justify-between gap-6"><dt>Faculty taught</dt><dd class="text-ink">300+</dd></div>
      <div class="flex justify-between gap-6"><dt>Now</dt><dd class="text-ink">Siemens · VU · AISO</dd></div>
      <div class="flex justify-between gap-6"><dt>Status</dt><dd class="text-accent">Open to opportunities</dd></div>
    </dl>
  </div>
</section>
