---
import { getCollection } from 'astro:content';
import SectionHead from './SectionHead.astro';

const entries = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
const work = entries.filter((e) => e.data.kind !== 'education');
const education = entries.filter((e) => e.data.kind === 'education');
---

<section id="experience" class="scroll-mt-20 px-5 py-20 sm:px-8 sm:py-28">
  <SectionHead index="03" label="Track record" title="Experience" />

  <div class="grid gap-14 lg:grid-cols-[1.35fr_1fr]">
    <ol class="space-y-0">
      {
        work.map(({ data }) => (
          <li class="border-line grid gap-x-8 gap-y-2 border-b py-7 sm:grid-cols-[10.5rem_1fr]" data-reveal>
            <p class="voice-mono text-mute pt-1">{data.period}</p>
            <div>
              <h3 class="text-ink text-lg font-semibold tracking-tight">{data.role}</h3>
              <p class="voice-mono text-accent mt-1">
                {data.org} · <span class="text-mute">{data.place}</span>
              </p>
              <ul class="text-mute mt-3 space-y-1.5 text-[14.5px] leading-relaxed">
                {data.points.map((point) => (
                  <li class="flex gap-2.5">
                    <span class="text-accent mt-[3px] shrink-0 text-[10px]" aria-hidden="true">
                      ▸
                    </span>
                    {point}
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="self-start">
      <h3 class="voice-mono text-mute mb-2" data-reveal>Education</h3>
      <ol>
        {
          education.map(({ data }) => (
            <li class="border-line border-b border-dashed py-6" data-reveal>
              <p class="voice-mono text-mute">{data.period}</p>
              <h4 class="text-ink mt-1.5 font-semibold tracking-tight">{data.role}</h4>
              <p class="voice-mono text-mute mt-1 normal-case tracking-normal">
                {data.org} - {data.place}
              </p>
              <p class="text-mute mt-2 text-[14px] leading-relaxed">{data.points[0]}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
