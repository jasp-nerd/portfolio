---
import SplitLines from './SplitLines.astro';
import { site } from '../lib/site';

const year = new Date().getFullYear();
---

<footer id="contact" class="border-line scroll-mt-20 border-t px-5 pt-20 pb-8 sm:px-8 sm:pt-28">
  <p class="voice-mono text-mute mb-8" data-reveal>05 — Contact</p>

  <h2 class="voice-display text-[clamp(3rem,11vw,10rem)]">
    <SplitLines lines={['Let’s build', 'something', '<span class="text-accent">real</span>.']} />
  </h2>

  <div class="mt-10 flex flex-wrap items-center gap-4" data-reveal>
    <a
      href={`mailto:${site.email}`}
      class="pressable bg-ink text-bg voice-mono rounded-full px-7 py-4 tracking-[0.18em]"
    >
      {site.email}
    </a>
    <a
      href={site.github}
      target="_blank"
      rel="noopener noreferrer"
      class="pressable border-line voice-mono text-ink hover:border-ink rounded-full border px-6 py-4 transition-colors duration-200"
    >
      GitHub ↗
    </a>
    <a
      href={site.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="pressable border-line voice-mono text-ink hover:border-ink rounded-full border px-6 py-4 transition-colors duration-200"
    >
      LinkedIn ↗
    </a>
  </div>

  <p class="text-mute mt-8 max-w-md text-[14px] leading-relaxed" data-reveal>
    Open to working-student roles, internships and collaborations across AI, data
    science and software engineering. Amsterdam or remote.
  </p>

  <div
    class="voice-mono text-mute border-line mt-20 flex flex-wrap items-center justify-between gap-3 border-t pt-6"
  >
    <span>© {year} {site.name}</span>
    <a
      href="https://github.com/jasp-nerd/portfolio"
      target="_blank"
      rel="noopener noreferrer"
      class="link-line hover:text-ink transition-colors duration-200"
    >
      Source ↗
    </a>
  </div>
</footer>
