---
interface Props {
  index: string;
  label: string;
  title: string;
}

const { index, label, title } = Astro.props;
---

<div class="border-line mb-12 border-t pt-5 sm:mb-16">
  <p class="voice-mono text-mute" data-reveal>
    <span class="text-accent">{index}</span> - {label}
  </p>
  <h2 class="voice-display mt-4 text-[clamp(2.2rem,6vw,4.5rem)]" data-reveal>{title}</h2>
</div>
