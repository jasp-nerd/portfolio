---
/**
 * Schematic line-art figure per project, in the site's lab-diagram style.
 * Strokes inherit currentColor; highlights use the accent token. Paths carry
 * class "draw" so motion.ts can play a draw-on stroke animation on scroll.
 */
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<svg
  viewBox="0 0 240 200"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class="project-figure h-full w-full"
  role="img"
  aria-hidden="true"
  data-figure={id}
>
  {
    id === 'vu-education-lab-ai-assistant' && (
      <>
        {/* browser window */}
        <rect class="draw" x="24" y="28" width="140" height="110" rx="8" />
        <path class="draw" d="M24 52h140" />
        <circle cx="38" cy="40" r="3" class="draw" />
        <circle cx="50" cy="40" r="3" class="draw" />
        {/* page text lines */}
        <path class="draw" d="M40 72h72M40 86h96M40 100h60M40 114h84" opacity="0.55" />
        {/* transform arrow */}
        <path class="draw accent" d="M170 84h34m0 0-9-9m9 9-9 9" />
        {/* quiz card output */}
        <rect class="draw accent" x="150" y="112" width="66" height="60" rx="6" />
        <path class="draw" d="M162 128h28M162 142h36M162 156h22" opacity="0.55" />
        <path class="draw accent" d="m204 126 3 4 6-8" />
        {/* sparkle */}
        <path class="draw accent" d="M196 40v16M188 48h16M191 43l10 10M201 43l-10 10" />
      </>
    )
  }
  {
    id === 'vu-ai-student-hub' && (
      <>
        {/* 7x5 course grid */}
        {Array.from({ length: 35 }, (_, i) => {
          const x = 30 + (i % 7) * 22;
          const y = 36 + Math.floor(i / 7) * 22;
          const filled = [2, 8, 11, 16, 19, 24, 30].includes(i);
          return (
            <rect
              class={filled ? 'draw accent' : 'draw'}
              x={x}
              y={y}
              width="14"
              height="14"
              rx="3"
              opacity={filled ? 1 : 0.5}
            />
          );
        })}
        {/* chat bubble */}
        <path class="draw accent" d="M192 118h26a8 8 0 0 1 8 8v22a8 8 0 0 1-8 8h-14l-10 10v-10h-2a8 8 0 0 1-8-8v-22a8 8 0 0 1 8-8Z" />
        <path class="draw" d="M194 132h22M194 142h14" opacity="0.55" />
      </>
    )
  }
  {
    id === 'canvas-course-downloader' && (
      <>
        {/* course tree */}
        <rect class="draw" x="28" y="30" width="52" height="18" rx="4" />
        <path class="draw" d="M40 48v76M40 66h22M40 90h22M40 114h22" opacity="0.7" />
        <rect class="draw" x="64" y="58" width="44" height="16" rx="4" opacity="0.7" />
        <rect class="draw" x="64" y="82" width="52" height="16" rx="4" opacity="0.7" />
        <rect class="draw" x="64" y="106" width="38" height="16" rx="4" opacity="0.7" />
        {/* download arrow */}
        <path class="draw accent" d="M148 64v52m0 0-14-14m14 14 14-14" />
        {/* zip box */}
        <rect class="draw accent" x="122" y="132" width="52" height="40" rx="6" />
        <path class="draw" d="M148 132v40M141 140h14M141 152h14M141 164h14" opacity="0.7" />
        {/* users count ticks */}
        <path class="draw" d="M196 60v-16M208 68V36M220 76V52" opacity="0.8" />
        <path class="draw accent" d="M190 84h38" />
      </>
    )
  }
  {
    id === 'kamernet-scraper' && (
      <>
        {/* radar rings */}
        <circle class="draw" cx="104" cy="96" r="24" opacity="0.9" />
        <circle class="draw" cx="104" cy="96" r="46" opacity="0.55" />
        <circle class="draw" cx="104" cy="96" r="68" opacity="0.3" />
        {/* house blip */}
        <path class="draw accent" d="m96 92 8-8 8 8v12h-16V92Z" />
        {/* sweep */}
        <path class="draw accent" d="M104 96 158 62" opacity="0.8" />
        {/* notification card */}
        <rect class="draw accent" x="176" y="112" width="48" height="56" rx="6" />
        <path class="draw" d="M186 126h28M186 138h20M186 150h24" opacity="0.55" />
        <circle class="draw accent" cx="220" cy="116" r="5" />
      </>
    )
  }
  {
    id === 'mario-rl' && (
      <>
        {/* axes */}
        <path class="draw" d="M36 36v128h176" />
        {/* two reward curves */}
        <path class="draw" d="M44 148c24-6 34-28 52-34s34 4 50-8 30-40 62-46" opacity="0.6" />
        <path class="draw accent" d="M44 152c30-2 40-44 62-56s42 2 58-18 24-30 44-34" />
        {/* pixel block */}
        <rect class="draw" x="180" y="120" width="14" height="14" rx="2" />
        <rect class="draw" x="196" y="104" width="14" height="14" rx="2" opacity="0.7" />
        {/* legend ticks */}
        <path class="draw accent" d="M52 48h16" />
        <path class="draw" d="M52 60h16" opacity="0.6" />
      </>
    )
  }
</svg>

<style>
  .project-figure .accent {
    stroke: var(--color-accent);
  }
</style>
